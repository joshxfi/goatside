{
  "name": "goatside",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An open-source, self-hosted personal finance tracker with an agent that files what you type.",
  "license": "MIT",
  "author": "Josh Daniel (https://github.com/joshxfi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshxfi/goatside.git"
  },
  "bugs": "https://github.com/joshxfi/goatside/issues",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:dev": "pnpm --filter @workspace/db dev",
    "db:generate": "pnpm --filter @workspace/db generate",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:studio": "pnpm --filter @workspace/db studio",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  }
}
