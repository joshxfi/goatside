# Copy to .env.local for local development. On Vercel, add each of these
# under Project → Settings → Environment Variables (`vercel env pull` brings
# them back down into .env.local).

# Auth
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=you@gmail.com

# Database: `pnpm db:dev` serves a local libSQL server on :8080.
# In production, use your Turso database URL and token.
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# AI (Vercel AI Gateway). On Vercel, OIDC authenticates automatically and
# this key is optional; locally, create one in the AI Gateway dashboard.
AI_GATEWAY_API_KEY=
