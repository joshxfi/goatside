{
  "name": "@workspace/ai",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file-if-exists=../../apps/goatside/.env.local evals/categorize.ts && tsx --env-file-if-exists=../../apps/goatside/.env.local evals/people.ts && tsx --env-file-if-exists=../../apps/goatside/.env.local evals/duplicates.ts && tsx --env-file-if-exists=../../apps/goatside/.env.local evals/accounts.ts",
    "eval:people": "tsx --env-file-if-exists=../../apps/goatside/.env.local evals/people.ts",
    "eval:duplicates": "tsx --env-file-if-exists=../../apps/goatside/.env.local evals/duplicates.ts",
    "eval:accounts": "tsx --env-file-if-exists=../../apps/goatside/.env.local evals/accounts.ts"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@workspace/core": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
